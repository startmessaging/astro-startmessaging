---
/**
 * TeamSection — founder / team cards: round photo, name, role, bio, LinkedIn.
 *
 * Example JSON:
 * {
 *   "type": "teamSection",
 *   "props": {
 *     "heading":    { "en": "Founding team" },
 *     "subheading": { "en": "StartMessaging is built by a small team…" },
 *     "members": [
 *       {
 *         "name":     "Madhav Dadhich",
 *         "role":     { "en": "Co-founder" },
 *         "bio":      { "en": "Madhav co-founded StartMessaging…" },
 *         "image":    "/images/team/madhav-dadhich.jpg",
 *         "linkedin": "https://www.linkedin.com/in/madhavdadhich/"
 *       }
 *     ]
 *   }
 * }
 */
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import Text from '@/components/ui/Text.astro';
import { r } from '@/i18n/r';

const { heading, subheading, members = [], country, theme = 'sms' } = Astro.props;

const isWhatsapp = theme === 'whatsapp';
const cardBgClass = isWhatsapp ? 'bg-white/60 border border-accent-wa/10 shadow-sm' : 'bg-surface-card border border-hairline shadow-sm';
const accentClass = isWhatsapp ? 'text-accent-wa' : 'text-primary';

// Photos live in src/assets/images (same "/images/…" convention as FeatureSplit).
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,webp}');
const resolved = await Promise.all(
  members.map(async (m: any) => {
    const loader = m.image ? images[m.image.replace(/^\/images\//, '/src/assets/images/')] : undefined;
    return { ...m, asset: loader ? (await loader()).default : null };
  })
);

const linkedinLabel = {
  en: 'LinkedIn profile', pt: 'Perfil no LinkedIn', es: 'Perfil de LinkedIn',
  id: 'Profil LinkedIn', ar: 'الملف الشخصي على LinkedIn', tr: 'LinkedIn profili',
};
---

<Section theme={theme}>
  <Container>
    {(heading || subheading) && (
      <div class="mb-12 flex flex-col items-center text-center gap-4">
        {heading && <Heading as="h2">{r(heading, country)}</Heading>}
        {subheading && <Text tone="muted" class="max-w-2xl">{r(subheading, country)}</Text>}
      </div>
    )}

    <ul class:list={['grid gap-8', resolved.length > 1 ? 'md:grid-cols-2' : 'max-w-2xl mx-auto']}>
      {resolved.map((m: any) => (
        <li class:list={['flex flex-col gap-6 p-8 rounded-lg', cardBgClass]}>
          <div class="flex items-center gap-6">
            {m.asset ? (
              <Image
                src={m.asset}
                alt={m.name}
                width={176}
                height={176}
                widths={[176, 352]}
                sizes="176px"
                class="h-28 w-28 sm:h-36 sm:w-36 shrink-0 rounded-full object-cover border border-hairline"
                loading="lazy"
              />
            ) : (
              <div class="h-28 w-28 sm:h-36 sm:w-36 shrink-0 rounded-full bg-surface-soft flex items-center justify-center text-display-sm font-bold text-ink">
                {m.name.split(' ').map((p: string) => p[0]).join('')}
              </div>
            )}
            <div class="flex flex-col gap-1">
              <Heading as="h3" size="display-sm" class="!font-semibold">{m.name}</Heading>
              <span class:list={['text-body-sm font-medium', accentClass]}>{r(m.role, country)}</span>
            </div>
          </div>

          <Text tone="body">{r(m.bio, country)}</Text>

          {m.linkedin && (
            <a
              href={m.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class:list={['inline-flex items-center gap-2 text-body-sm font-medium hover:underline w-fit', accentClass]}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
              </svg>
              {r(linkedinLabel, country)}
            </a>
          )}
        </li>
      ))}
    </ul>
  </Container>
</Section>
